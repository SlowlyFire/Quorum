# Copy to server/.env and fill in. Never commit server/.env.

# Optional — these have development defaults (3000, development, http://localhost:5173).
PORT=
NODE_ENV=
CLIENT_URL=

# Required always. The process refuses to boot without them.
# JWT_SECRET must additionally be >= 32 characters when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# OPENROUTER_API_KEY is every LLM call in the product — get one at
# https://openrouter.ai/keys and set a hard spend cap on it in their dashboard.
DATABASE_URL=
JWT_SECRET=
OPENROUTER_API_KEY=

# Required only when NODE_ENV=production — nothing reads them yet.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required only when NODE_ENV=production. Wallet top-ups need them; nothing else
# does, so the API boots without them and POST /api/wallet/checkout answers 503.
# TEST MODE — the integration is production-shaped, the keys are not real money.
#   STRIPE_SECRET_KEY     sk_test_... from https://dashboard.stripe.com/test/apikeys
#   STRIPE_WEBHOOK_SECRET whsec_... printed by `stripe listen --forward-to \
#                         localhost:3000/api/webhooks/stripe`, and DIFFERENT from
#                         the dashboard endpoint's secret — the CLI signs with its
#                         own. A mismatch is a 400 with "No signatures found".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
